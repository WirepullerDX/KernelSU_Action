CONFIG_ENV=config/lmi.env
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_sm8250
KERNEL_SOURCE_BRANCH=lineage-23.2
KERNEL_CONFIG=vendor/kona-perf_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
EXTRA_CMDS=LD=ld.lld
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-
KSU_VARIANT=kernelsu-next
KSU_REF=legacy
KSU_HOOK_MODE=manual
ENABLE_SUSFS=false
ENABLE_KPM=false
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=CONFIG_MSM_IDLE_STATS=n CONFIG_PAGE_EXTENSION=n CONFIG_PAGE_OWNER=n CONFIG_DEBUG_FS=n CONFIG_BUILD_ARM64_DT_OVERLAY=y CONFIG_QCA_CLD_WLAN=y CONFIG_QCA_CLD_WLAN_PROFILE="qca6390" CONFIG_DEBUG_FS=n CONFIG_MSM_TZ_LOG=n CONFIG_CMA_DEBUGFS=n CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS=n CONFIG_IPA_UT=n CONFIG_IOMMU_TESTS=n CONFIG_QMP_DEBUGFS_CLIENT=n CONFIG_EXFAT_FS=y CONFIG_EROFS_FS=y CONFIG_PSTORE=y CONFIG_PSTORE_CONSOLE=y CONFIG_PSTORE_PMSG=y CONFIG_PSTORE_RAM=y CONFIG_BLK_WBT=y CONFIG_BLK_WBT_SQ=y CONFIG_MTD=y CONFIG_MTD_BLOCK=y CONFIG_MTD_OOPS=y CONFIG_MTD_BLOCK2MTD=y CONFIG_BACKLIGHT_KTZ8866=y CONFIG_BACKLIGHT_DUALKTZ8866=y CONFIG_MOTOR_DRV8846=y CONFIG_AIROHA_GPS=y CONFIG_HALL_AKM09970=y CONFIG_ION_CAMERA_HEAP=y CONFIG_RC_CORE=y CONFIG_LIRC=y CONFIG_RC_DECODERS=y CONFIG_RC_DEVICES=y CONFIG_IR_SPI=y CONFIG_INPUT_XIAOMI_KEYBOARD=y CONFIG_KEYBOARD_NANO_8030=y CONFIG_LEDS_AW2015=y CONFIG_FRAME_WARN=4096 CONFIG_SMB1355_SLAVE_CHARGER=n CONFIG_SMB1390_CHARGE_PUMP_PSY=n CONFIG_SMB1398_CHARGER=n CONFIG_I2C_RETRY=y CONFIG_REGULATOR_PM8008=y CONFIG_REGULATOR_QCOM_RPMH=y CONFIG_TOUCHSCREEN_FTS=n CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=n CONFIG_TOUCHSCREEN_ST=n CONFIG_TOUCHSCREEN_COMMON=y CONFIG_PS5169=y CONFIG_INPUT_QTI_HAPTICS=n CONFIG_MACH_XIAOMI_LMI=y CONFIG_TOUCHSCREEN_FTS_MI=y CONFIG_TOUCHSCREEN_FTS_FOD=y CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y CONFIG_INPUT_FINGERPRINT=y CONFIG_FINGERPRINT_GOODIX_FOD=y CONFIG_BQ2597X_CHARGE_PUMP=y CONFIG_BATT_VERIFY_BY_DS28E16=y CONFIG_ONEWIRE_GPIO=y CONFIG_INPUT_AW8697_HAPTIC=y CONFIG_TECHPACK_CAMERA_XIAOMI=y CONFIG_LOCALVERSION_AUTO=n CONFIG_LOCALVERSION="-perf-g71b13e62f057"
NEED_DTBO=false
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://mirrorbits.lineageos.org/full/lmi/20261104/boot.img
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
